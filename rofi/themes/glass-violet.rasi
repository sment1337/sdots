/* =========================================================
 *  rofi — "liquid glass" violet theme
 *  Semi-transparent background + picom blur = glass overlay.
 * ========================================================= */

configuration {
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus";
    drun-display-format: "{name}";
}

* {
    bg:      rgba ( 23, 15, 44, 72 % );
    bg-alt:  rgba ( 48, 34, 84, 60 % );
    fg:      #f5f2ff;
    dim:     #9a8fb8;
    accent:  #a78bfa;
    urgent:  #ff5c8a;

    background-color: transparent;
    text-color:       @fg;
    border:      0;
    margin:      0;
    padding:     0;
    spacing:     0;
}

/* the floating glass panel */
window {
    location:        center;
    anchor:          center;
    width:           620;
    y-offset:        -10;
    background-color: @bg;
    border:          1px;
    border-color:    rgba ( 167, 139, 250, 45 % );
    border-radius:   16px;
    padding:         20px;
    children:        [ mainbox ];
}

mainbox {
    spacing:  14;
    children: [ inputbar, message, listview, mode-switcher ];
}

/* search line */
inputbar {
    spacing:          10;
    padding:          12px 16px;
    border-radius:    10px;
    background-color: @bg-alt;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "search…";
    placeholder-color: @dim;
    cursor:      text;
}

/* results */
listview {
    fixed-height: false;
    lines:        8;
    spacing:      4;
    scrollbar:    false;
    padding:      4px 6px;
}

element {
    padding:       8px 12px;
    border-radius: 10px;
    text-color:    @fg;
}

element normal.normal { text-color: @fg; }
element normal.urgent { text-color: @urgent; }
element normal.active { text-color: @accent; }

element selected {
    background-color: rgba ( 167, 139, 250, 22 % );
    text-color:       @accent;
    border:           1px;
    border-color:     rgba ( 167, 139, 250, 40 % );
}

element-icon { size: 1.1em; padding: 0 6px 0 0; }

/* mode tabs (window / run / ssh / drun) */
mode-switcher {
    spacing: 8;
    padding: 4px 6px 0px 6px;
}

button {
    padding:          6px 14px;
    border-radius:    8px;
    text-color:       @dim;
}

button selected {
    background-color: rgba ( 167, 139, 250, 22 % );
    text-color:       @accent;
}

message {
    padding:          10px 14px;
    border-radius:    10px;
    background-color: rgba ( 255, 92, 138, 12 % );
    text-color:       @urgent;
}
